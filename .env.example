NODE_ENV=production
PORT=3000

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace_with_long_random_secret

# TBC Bank
TBC_IPAY_KEY=replace_with_tbc_key
TBC_IPAY_SECRET=replace_with_tbc_secret
TBC_API_URL=https://api.tbcbank.ge

# Bank of Georgia
BOG_MERCHANT_ID=replace_with_bog_merchant_id
BOG_SECRET_KEY=replace_with_bog_secret_key
BOG_API_URL=https://api.ecommerce.bog.ge/payment/start

# URLs
RETURN_URL=https://your-domain.com
CALLBACK_SUCCESS_URL=https://your-domain.com
CALLBACK_FAIL_URL=https://your-domain.com/balance

# Email Service (Gmail)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# AI
OPENAI_API_KEY=replace_with_openai_api_key